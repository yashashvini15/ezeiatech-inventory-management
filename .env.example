# Is file ko copy karke .env banao:  cp .env.example .env   (phir values badlo)
# .env kabhi git me commit mat karna (.gitignore me hai)

# Database
DB_HOST=localhost
DB_NAME=inventory_db
DB_USER=inventory_user
DB_PASSWORD=change-me

# JWT: base64 secret, kam se kam 32 bytes. Banane ke liye:  openssl rand -base64 32
JWT_SECRET=change-me-base64-secret
JWT_EXPIRATION_MS=7200000

# Frontend ka origin (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Login rate limit
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_WINDOW_SECONDS=900

# Business config
ORDER_TAX_RATE=0.18
REPORT_ZONE=Asia/Kolkata

# Docker
FRONTEND_PORT=3000
DOCKERHUB_USER=yashu15
IMAGE_TAG=1.0.0